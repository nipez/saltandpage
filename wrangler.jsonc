{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salt-and-page",
  // Set this to today's date
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Optional: "ALLOWED_ORIGINS": "https://saltandpage.example,https://www.saltandpage.example",
    "AI_RATE_LIMIT": "20",
    "AI_RATE_LIMIT_PERIOD": "60"
  },
  // Create once, then paste ids (see README):
  //   npx wrangler kv namespace create AI_RATE_LIMIT_KV
  //   npx wrangler kv namespace create AI_RATE_LIMIT_KV --preview
  // Local `wrangler dev` / Vite uses an in-memory KV mock with these placeholders.
  "kv_namespaces": [
    {
      "binding": "AI_RATE_LIMIT_KV",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000002"
    }
  ]
  // Optional stronger edge limiter (period must be 10 or 60):
  // "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "874201", "simple": { "limit": 20, "period": 60 } }]
  // Secrets: `npx wrangler secret put ANTHROPIC_API_KEY`
}
